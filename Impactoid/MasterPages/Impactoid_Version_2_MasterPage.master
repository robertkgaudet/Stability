<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Impactoid_Version_2_MasterPage.master.cs" Inherits="Impactoid_Version_2_MasterPage" %>

<!DOCTYPE html>
<html>
<head>
    <script type="text/javascript">
        $('.btndonate').click(function () {
            window.location.href = '<%=donateURL%>';
            return false;
        });
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-96039646-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-96039646-1');

    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title runat="server" id="title">Impactoid - After a disaster get your own website for organizing a disaster relief team.</title>
    <meta name="description" id="description" runat="server" content="Everything you need to create a website to organize your community." />
    <meta property="og:title" id="fbTitle" runat="server" content="Impactoid - Community Based Disaster Relief Teams" />
    <meta property="og:site_name" id="fbSite_name" runat="server" content="Impactoid" />
    <meta property="og:description" id="fbDescription" runat="server" content="Create a website that organizes your own disaster relief team." />
    <meta property="og:image:type" id="fbImageType" runat="server" />
    <meta property="og:image" id="fbImage" runat="server" content="/Impactoid/Images/TTF.jpg" />
    <meta property="og:url" id="fbURL" runat="server" content="http://www.Impactoid.com/" />

    <!-- Responsive viewport 
        ==================================================-->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Favicon
        ==================================================================-->
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#b16565">

    <!-- Bootstrap css
        ==================================================================-->
    <link rel="stylesheet" href="aid/css/bootstrap.css">

    <!-- FontAwesome css
        =====================================================================-->
    <link rel="stylesheet" href="aid/css/font-awesome.css">

    <!-- Simple Ticker css
        =====================================================================-->
    <link rel="stylesheet" href="aid/css/jquery.simpleTicker.css">

    <!-- Owl Carousel css
        =====================================================================-->
    <link rel="stylesheet" href="aid/css/owl.carousel.css">
    <link rel="stylesheet" href="aid/css/owl.theme.default.css">

    <!-- Animate css
        =====================================================================-->
    <link rel="stylesheet" href="aid/css/animate.css">

    <!-- PrettyPhoto css
        =====================================================================-->
    <link rel="stylesheet" href="aid/css/prettyPhoto.css">

    <!-- Style css
        ==================================================================== -->
    <link rel="stylesheet" href="aid/style.css">

    <!-- Responsive css
        ===================================================================== -->
    <link rel="stylesheet" href="aid/css/responsive.css">

    <!--[if lt IE 9]>
            <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
            <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
            <![endif]-->
</head>

<body class="white-bg">
    <form id="form1" runat="server">

        <!-- START SITE PRELOADER -->
        <div id="pureheart-preloader-container">
            <div class="pureheart-preloader">
                <span></span>
            </div>
        </div>
        <!-- END SITE PRELOADER -->

        <!-- HEADER AREA START -->
        <header class="header-area" id="home">
            <div class="header-bottom">
                <div class="header-top">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-5 col-sm-5">
                                <div class="rss-feed">
                                    <div id="rss-item" class="ticker">
                                        <asp:ContentPlaceHolder ID="cphTicker" runat="server"></asp:ContentPlaceHolder>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7 col-sm-7 hidden-xs">
                                <asp:ContentPlaceHolder ID="cphTopContent" runat="server"></asp:ContentPlaceHolder>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="main-menu">
                                <nav class="navbar navbar-default">
                                    <div class="row">
                                        <div class="col-md-3 col-sm-12">
                                            <div class="navbar-header">
                                                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                                                    <span class="sr-only">Toggle navigation</span>
                                                    <span class="icon-bar"></span>
                                                    <span class="icon-bar"></span>
                                                    <span class="icon-bar"></span>
                                                </button>
                                                <a class="navbar-brand" href="CommunityPage.aspx?organizationId=<%=organizationId%>">
                                                    <asp:Image ID="imgLogo" runat="server" />
                                                    <h3>
                                                        <asp:Literal ID="litLogo" runat="server"></asp:Literal></h3>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="col-md-7 col-sm-12">
                                            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                                                <ul class="nav navbar-nav">
                                                    <li class="smooth-menu"><a href="#about">About</a>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#<%=divCauses.ClientID%>">Deployments</a>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#<%=divProgram.ClientID%>">Programs</a>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#gallery">Gallery</a>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#testimonial">Partners</a>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#blog">blog</a>
                                                        <ul class="sub-menu">
                                                            <li><a href="aid/blog-one-column.html">blog style 1</a></li>
                                                            <li><a href="aid/blog-two-columns.html">blog style 2</a></li>
                                                            <li><a href="aid/single-blog.html">single blog</a></li>
                                                        </ul>
                                                    </li>
                                                    <li class="smooth-menu"><a href="#contact">Contact</a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <!-- navbar-collapse -->
                                        </div>
                                        <div class="col-md-2 hidden-sm hidden-xs">
                                            <% if (ShowDonationButton && DonationCampaigns.Any(x => x.IsDefault))
                                                { %>
                                            <div class="menu-btn">
                                                <a href="/V1/NonProfit/DonationDetails.aspx?organizationId=<%= organizationId %>&donationCampaignId=<%= DonationCampaigns.FirstOrDefault(x => x.IsDefault).DonationCampaignId %>" class="btn-filled">Donate Now</a>
                                            </div>

                                            <% } %>
                                        </div>

                                    </div>
                                </nav>
                            </div>
                            <!-- Main Menu End -->
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <!-- HEADER AREA END -->

        <!-- SLIDER AREA START -->
        <asp:ContentPlaceHolder ID="cphSlider" runat="server"></asp:ContentPlaceHolder>
        <!-- SLIDER AREA END -->

        <!--  ABOUT AREA START -->
        <section class="about-area home3-about" id="about">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">
                                <asp:ContentPlaceHolder ID="cphOrgName" runat="server"></asp:ContentPlaceHolder>
                            </h2>
                            <p>
                                <asp:ContentPlaceHolder ID="cphDescription" runat="server"></asp:ContentPlaceHolder>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="about-wrap">
                            <ul>
                                <li class="ab-single clearfix">
                                    <div class="col-md-6 col-sm-6">
                                        <img src="aid/images/about1.jpg" alt="">
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="ab-content">
                                            <h4>Our Mission</h4>
                                            <p>
                                                <asp:ContentPlaceHolder ID="cphMission" runat="server"></asp:ContentPlaceHolder>
                                            </p>
                                        </div>
                                    </div>
                                </li>
                                <li class="ab-single clearfix">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="ab-content">
                                            <h4>Our History</h4>
                                            <p>
                                                <asp:ContentPlaceHolder ID="cphHistory" runat="server"></asp:ContentPlaceHolder>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <img src="aid/images/about2.jpg" alt="">
                                    </div>
                                </li>
                                <li class="ab-single clearfix">
                                    <div class="col-md-6 col-sm-6">
                                        <img src="aid/images/about3.jpg" alt="">
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="ab-content">
                                            <h4>A Few Words About Us</h4>
                                            <p>
                                                <asp:ContentPlaceHolder ID="cphAboutUs" runat="server"></asp:ContentPlaceHolder>
                                            </p>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!--  ABOUT AREA END -->


        <asp:ContentPlaceHolder ID="cphDisasters" runat="server"></asp:ContentPlaceHolder>

        <!-- PURE FUN AREA START -->
        <section class="home3-fun section-padding">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">SUCCESS STORIES</h2>
                            <p>No request for us is ever too small. We find countless creative ways to help a community in crisis. Here is the result our impact on the community.</p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="p-fun-wrap">
                            <div class="single-fun">
                                <i class="fa fa-heart"></i>
                                <h5>Volunteer Hours</h5>
                                <span class="counter">6850</span>
                            </div>
                            <div class="single-fun">
                                <i class="fa fa-users"></i>
                                <h5>Total Volunteers</h5>
                                <span class="counter">245</span>
                            </div>
                            <div class="single-fun">
                                <i class="fa fa-money"></i>
                                <h5>Volunteer Financial Impact</h5>
                                <span class="counter">6,445</span>
                            </div>
                            <div class="single-fun">
                                <i class="fa fa-money"></i>
                                <h5>Donated Resources</h5>
                                <span class="counter">12,000</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- PURE FUN AREA END -->
        <!--  OUR CAUSES AREA START -->
        <div class="our-causes-area grey-bg section-padding" id="divCauses" runat="server">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">our deployments</h2>
                            <p>
                                Choose a deployment to volunteer or donate to below.
                            </p>
                        </div>
                    </div>
                    <asp:ContentPlaceHolder ID="cphCauses" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
        <!--  OUR CAUSES AREA END -->

        <!-- DONATE NOW AREA START -->
        <div class="donate-now home3-donate">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="donate-txt">
                            <h3>TO CHANGE THE LIFE OF THOSE <span>WHO HAVE NO HOPE</span></h3>
                            <% if (ShowDonationButton && DonationCampaigns.Any(x => x.IsDefault))
                                { %>
                            <div class="menu-btn">
                                <a href="/V1/NonProfit/DonationDetails.aspx?organizationId=<%= organizationId %>&donationCampaignId=<%= DonationCampaigns.FirstOrDefault(x => x.IsDefault).DonationCampaignId %>" class="btn-filled">Donate Now</a>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- DONATE NOW AREA END -->

        <!--  OUR PROGRAM AREA START -->
        <div class="service-area" id="divProgram" runat="server">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">Our Programs</h2>
                            <p>
                                <asp:ContentPlaceHolder ID="cphProgramOverview" runat="server"></asp:ContentPlaceHolder>
                            </p>
                        </div>
                    </div>
                    <asp:ContentPlaceHolder ID="cphPrograms" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
        <!--  OUR SERVICE AREA END -->

        <!--  OUR GALLERY AREA END -->
        <div class="gallery-area section-padding" id="gallery">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">OUR Gallery</h2>
                            <p>Photos from our causes.</p>
                        </div>
                        <div class="gallery-menu">
                            <ul>
                                <asp:ContentPlaceHolder ID="cphGallery" runat="server"></asp:ContentPlaceHolder>
                            </ul>
                        </div>
                        <div class="gallery-grid">
                            <!-- Single Gallery -->
                            <asp:ContentPlaceHolder ID="cphGalleryGrid" runat="server"></asp:ContentPlaceHolder>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--  OUR GALLERY AREA END -->

        <!--  OUR TEAM AREA START -->
        <div class="our-team grey-bg section-padding" id="team">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="sectino-intro">
                            <h2 class="section-heading">OUR RELIEF TEAM</h2>
                            <p>Our core team members who have stepped up in this communities time of need.</p>
                        </div>
                    </div>
                    <asp:ContentPlaceHolder ID="cphTeam" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
        <!--  OUR TEAM AREA END -->

        <%--        <!--  PARTNER AREA START --> 
        <div class="testimonial-area" id="testimonial">
            <div class="container">
                <div class="row">
                   <div class="col-md-12">
                       <div class="sectino-intro">
                            <h2 class="section-heading">Partners</h2>
                        </div>
                   </div>
                    <div class="col-md-12">
                        <div class="testimonial-wrap owl-carousel owl-theme">
                            <!-- Single Quote -->
                            <div class="single-quote">
                                <div class="quote-thumb">
                                    <img src="aid/images/quote1.jpg" alt="">
