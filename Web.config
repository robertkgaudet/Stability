        </rule>
        <rule name="Rewrite to Categories">
          <match url="^c/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/S1/Default.aspx?category={R:1}" />
        </rule>
        <rule name="Rewrite Business to Event">
          <match url="^BusinessResponse/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/V1/Business/BusinessCampaign.aspx?businessEventFriendlyURLName={R:1}" />
        </rule>
        <rule name="Rewrite to Post.aspx">
          <match url="^a/([0-9]+)" />
          <action type="Rewrite" url="/S1/Post.aspx?number={R:1}" />
        </rule>
        <rule name="Register">
          <match url="^(.*)Register" />
          <action type="Rewrite" url="/V1/Register.aspx" />
        </rule>
        <rule name="SignIn">
