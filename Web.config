          <action type="Rewrite" url="/V1/Profile/Profile.aspx?profileNumber={R:1}" />
        </rule>
        <rule name="Rewrite Survivors to A Profile Page">
          <match url="^sp/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/S1/Profile/Default.aspx?profileNumber={R:1}" />
        </rule>
		<rule name="Rewrite Victim Ticket in Victim Folder">
			<match url="^ticket/([_0-9a-z-]+)" />
			<action type="Rewrite" url="/V1/Victim/Case.aspx?profileNumber={R:1}" />
		</rule>
        <rule name="Rewrite Survivors Profile in Case Management">
          <match url="^case/([_0-9a-z-]+)" />
