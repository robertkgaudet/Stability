		  <rule name="Feed">
			  <match url="^(.*)Feed" />
			  <action type="Rewrite" url="/V1/Stream.aspx" />
		  </rule>
		<rule name="Get Help">
			<match url="^(.*)GetHelp" />
			<action type="Rewrite" url="/V1/VictimAccount.aspx" />
		</rule>
		<rule name="Get Help Choose Specific Org">
			<match url="^GetHelp/([_0-9a-z-]+)" />
			<action type="Rewrite" url="/V1/VictimAccount.aspx?organizationId={R:1}" />
		</rule>
        <rule name="Rewrite Imapctoid Website URL">
          <match url="^i/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/Impactoid/CommunityPage.aspx?organizationName={R:1}" />
        </rule>
        <rule name="CauseSwipe">
          <match url="^(.*)CauseSwipe" />
          <action type="Rewrite" url="/V1/CauseSwipe.aspx" />
        </rule>
        <rule name="Rewrite County Page">
          <match url="^em/([_0-9a-z-]+)/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/V1/EmergencyManager.aspx?State={R:1}County={R:2}" />
        </rule>
        <rule name="Rewrite Register to Choose Specific Org">
          <match url="^Register/([_0-9a-z-]+)" />
          <action type="Rewrite" url="/V1/Register.aspx?organizationId={R:1}" />
        </rule>
        <rule name="Rewrite Disaster">
          <match url="^Disaster/([_0-9a-z-]+)" />
          <action type="Rewrite" url="V1/event.aspx?eventName={R:1}" />
        </rule>
        <rule name="Rewrite Disaster to NonProfits PAGE">
          <match url="^NonProfit/([_0-9a-z-]+)" />
          <action type="Rewrite" url="V1/NonProfit.aspx?eventName={R:1}" />
        </rule>
        <rule name="Rewrite Nonprofit to Event">
          <match url="^Cause/([_0-9a-z-]+)" />
