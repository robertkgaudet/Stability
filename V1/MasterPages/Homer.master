		<!-- Vendor scripts -->
		<script src="https://code.jquery.com/jquery-3.3.1.js" integrity="sha256-2Kok7MbOyxpgUVvAk/HJ2jigOSYS2auK4Pfzbm7uH60=" crossorigin="anonymous"></script>

		<script type="text/javascript">

            var userOrganizationEventId = "<%=_userOrganizationEventId%>";
            var organizationEventId = "";
            var checkTaskType = "true";
            var causeName = "";

			document.addEventListener("DOMContentLoaded", function () {
				const listItems = document.querySelectorAll("#userActionList li");

				listItems.forEach(item => {
					item.addEventListener("click", function () {
						const url = this.getAttribute("data-url");
						if (url) {
							window.location.href = url;
						}
					});
				});
			});

			$(document).ready(function () {

				$('.homeLink').click(function () {
					window.location.href = '/feed';
					return false;
				})
				$('.teamLink').click(function () {
					window.location.href = '/V1/NonProfit/Default.aspx?organizationId=79305f85-3816-46a8-911f-0d7e3e227c32';
					return false;
				})
				$('.portalLink').click(function () {
					window.location.href = '/V1/ChooseEvent.aspx';
					return false;
				})
				$('.profileLink').click(function () {
					window.location.href = '/V1/Profile/Profile.aspx';
					return false;
				})

				<%=_showUserActionModal%>
				
                $("#causeTypeList.dropdown-menu li").click(function () {
                    causeName = $(this).text();
                    $("#btn-causeDropdown.dropdown-chooseCause").html("<i class='fa fa-globe'></i> " + causeName);
                    $("#<%=hidCauseId.ClientID%>").val($(this).attr('id'));
                    $("#<%=lblCause.ClientID%>").html("<strong>Your Cause:</strong> " + causeName);
                    organizationEventId = $(this).attr('id');
                });

                $("#causeTypeListB.dropdown-menu li").click(function () {
                    $("#btn-causeDropdownB.dropdown-chooseCauseB").html("<i class='fa fa-globe'></i> " + $(this).text());
                    $("#<%=hidCauseBId.ClientID%>").val($(this).attr('id'));
                    $("#<%=lblCause.ClientID%>").html("<strong>Your Deployment:</strong> " + $(this).text());
                    organizationEventId = $(this).attr('id');
                });

                $("#workEventType.dropdown-menu li").click(function () {
                    $("#btn-dropdown.dropdown-taskType").html("<i class='pe-7s-id'></i> " + $(this).text());
                    $("#<%=hidTaskTypeId.ClientID%>").val($(this).attr('id'));
                });

                var workDescription = document.getElementById('<%=txtWorkDescription.ClientID%>').value;
                var workCompleteDescription = document.getElementById('<%=txtWorkCompleteDescription.ClientID%>').value;
                var taskTypeId = document.getElementById('<%=hidTaskTypeId.ClientID%>').value;
                var activeStatusButtonId = document.getElementById('<%=activeStatusButton.ClientID%>');
                var causeCountyMessage = document.getElementById('causeCountyMessage');
                var btnSubmitTime = document.getElementById('<%=btnSubmitTime.ClientID%>');
                var timeEntryDiv = document.getElementById('timeEntry');
                var timeEntryAlertDiv = document.getElementById('timeEntryAlert');
                var activeTrackingButton = document.getElementById('<%=activeTrackingButton.ClientID%>');
                var activeTrackingButtonId = document.getElementById('<%=activeTrackingButton.ClientID%>');
                activeTrackingButton.style.visibility = 'hidden';

                if ("<%=_noCause%>" == "true") {
                    //No cause
                    divTimesheet.hidden = true;

                    //Show the cause Divs
                    divChooseCause.hidden = false;
                }
                else {
                    //Has a cause
                    divTimesheet.hidden = false;

                    //Remove the cause Divs
                    divChooseCause.hidden = true;
                }

                if ("<%=_timeActive%>" == "true") {
                    timeEntryDiv.style.visibility = 'hidden';
                    causeCountyMessage.style.visibility = 'hidden';
                    btnSubmitTime.style.visibility = 'hidden';
                    activeStatusButtonId.style.visibility = 'hidden';
                    activeTrackingButton.style.visibility = 'visible';
                    timeEntryAlertDiv.hidden = false;
                    checkTaskType = false;
                }

				$('#<%=imgLogo.ClientID%>').click(function () {
					window.location.href = '/Default.aspx';
					return false;
				});

				$('#<%=imgProfile.ClientID%>').click(function () {
					window.location.href = <%=profileURL%>;
					return false;
                });
			});

            toastr.options = {
                "debug": false,
                "newestOnTop": true,
                "positionClass": "toast-top-center",
                "closeButton": true,
                "showDuration": "600",
                "toastClass": "animated fadeInDown",
            };

            function chooseCause()
            {
                //Now that we have a cause we can activate these items.

                divTimesheet.hidden = false;

                //Remove the cause Divs
                divChooseCause.hidden = true;
                $("#btn-causeDropdownB.dropdown-chooseCauseB").html("<i class='fa fa-globe'></i> " + causeName);
            }

            function updateTime(isUserActive)
            {
                workDescription = document.getElementById('<%=txtWorkDescription.ClientID%>').value;
                workCompleteDescription = document.getElementById('<%=txtWorkCompleteDescription.ClientID%>').value;
                taskTypeId = document.getElementById('<%=hidTaskTypeId.ClientID%>').value;
                activeStatusButtonId = document.getElementById('<%=activeStatusButton.ClientID%>');
                causeCountyMessage = document.getElementById('causeCountyMessage');
                btnSubmitTime = document.getElementById('<%=btnSubmitTime.ClientID%>'); 
                timeEntryDiv = document.getElementById('timeEntry');
                timeEntryAlertDiv = document.getElementById('timeEntryAlert');
                activeTrackingButton = document.getElementById('<%=activeTrackingButton.ClientID%>');

                if (!isUserActive) {
                    workDescription = workCompleteDescription;
                }

                if (taskTypeId == "" && checkTaskType) {
                    toastr.error('Error - Please choose a Volunteer Role.');
                    return;
                }
                else
                {
				    $.ajax(
					{
						type: "GET",
                            url: "/V1/Handlers/UpdateTimesheet.ashx?noCause=<%=_noCause%>&taskTypeId=" + taskTypeId + "&organizationEventId=" + organizationEventId + "&userOrganizationEventId=" + userOrganizationEventId + "&workDescription=" + workDescription + "&userId=<%=userId%>&isUserActive=" + isUserActive,
							data: "",
							contentType: "text/plain; charset=utf-8",
							dataType: "html",
							success: function (data) {
								if (data != "") {
									$('#console-event').html(data);
                                }
                                if (isUserActive) {
                                    //User signed in.
                                    timeEntryDiv.style.visibility = 'hidden';
                                    causeCountyMessage.style.visibility = 'hidden'; 
                                    btnSubmitTime.style.visibility = 'hidden';
                                    activeStatusButtonId.style.visibility = 'hidden';
                                    activeTrackingButton.style.visibility = 'visible';
                                    timeEntryAlertDiv.hidden = false;
                                    checkTaskType = false;
                                }
                                else
                                {
                                    //User signed out.
                                    timeEntryDiv.style.visibility = 'visible';
                                    causeCountyMessage.style.visibility = 'visible';
                                    btnSubmitTime.style.visibility = 'visible';
                                    activeStatusButtonId.style.visibility = 'visible';
                                    activeTrackingButton.style.visibility = 'hidden';
                                    timeEntryAlertDiv.hidden = true;
                                    checkTaskType = true;
                                }
							},
							error: function (request, status, error) {
								request.statusText + ' - ' + error + ' - ' + status;
							}
				    });
                 }
             }
		</script>

		<style>
            .btn-purple
            {
                background-color:#5E2E91;
                color:white;
            }
          .toast-message
			{
               color: #000;
            }
			.bodyBGColor
