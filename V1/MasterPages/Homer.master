		<script src="/Homer/vendor/metisMenu/dist/metisMenu.min.js"></script>
		<script src="/Homer/vendor/bootstrap-toggle-master/js/bootstrap-toggle.js"></script>
        <script src="/Homer/vendor/toastr/build/toastr.min.js"></script>
