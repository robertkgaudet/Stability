				background:none;
				border:none;
			}
			#<%=imgProfile.ClientID%>:hover
			{
				cursor:pointer;
			}
			.fa-bars
			{
				height:50px;
			}
			.fa-bars:hover
			{
				color:white;
			}
			#<%=imgProfile.ClientID%> {width:60%;}

			.toggle.ios, .toggle-on.ios, .toggle-off.ios { border-radius: 10px; width:200px; }
			.toggle.ios .toggle-handle { border-radius: 10px; }
			#<%=imgLogo.ClientID%>
			{
				margin:8px;
			}
			#<%=imgLogo.ClientID%>:hover
			{
				cursor:pointer;
			}
			.content
			{
				background-color:#F1F3F6 !important;
				color:#6A6C6F;
			}
			.liUserAction:hover
			{
				cursor:pointer;
				background-color:lightgray;
				color:white;
			}
			.ul_legend li
			{
				display: inline-block;
			}
		</style>
        <style>
			.skin-option {
					position: fixed;
					text-align: center;
					right: -1px;
					padding: 10px;
					font-size:12px;
					top: 5px;
					text-transform: uppercase;	
					background-color: #ffffff;
					box-shadow: 0 1px 3px 0px rgba(0, 0, 0, 0.05), 10px 5px 7px 3px rgba(0, 0, 0, .1);
					border-radius: 4px 0 0 4px;
					z-index: 100000;
				}
			.pe-7s-mail, .pe-7s-config, .pe-7s-keypad
			{
				color:white;
			}
			.pe-7s-mail:hover, .pe-7s-config:hover, .pe-7s-keypad:hover
			{
				color:black;
			}
			.text-danger{color:#FF0000;}
			.text-warning{color:#ffb606;}
			.text-success{color:#63CB31;}
			.text-website{color:#5E2E91;}

			.divMasterCover {
				width: 100%;
				height: 100vh; /* Full viewport height */
				background-image: url('<%=_masterCoverImage%>'); /* Path to your image */
				background-size: cover; /* Scale the image to cover the entire div */
				background-position: center; /* Center the image */
				background-repeat: no-repeat; /* Prevent the image from repeating */
				height:300px;
				margin-left:-1px;
				margin-top:0px;
				margin-bottom:-200px;
				background-color:#ccc;
			}

			.mobileFooter {
			  position: fixed;
			  bottom: -20px;
			  width: 100%;
			  background-color: #f1f1f1;
			  padding: 10px;
			  padding-bottom:50px;
			  text-align: center;
			  /* Additional styling for the footer */
			}

			@media only screen and (min-width: 768px) {
			  .mobileFooter {
				display: none;
			  }
			}

			.text-light-grey
			{
				color:gray !important;
			}
		</style>
