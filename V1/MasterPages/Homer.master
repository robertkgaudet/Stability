			<div class="modal fade" id="activeStatusModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div id="divChooseCause" hidden="hidden">
                            <div class="color-line"></div>
                            <div class="modal-header text-center">
                                <h4 class="modal-title"><asp:Literal ID="Literal3" runat="server"></asp:Literal> Volunteer Timesheet</h4>
                                <small class="thin-font">Enter a description of what you are working on and press Activate My Time.</small>
                            </div>
                            <div class="modal-body" style="position:relative;">
                                <div class="bg-success text-center p-xs m-b-sm  " id="chooseCauseWarning">
                                    <i class='fa fa-globe fa-4x'></i><br />
                                    <h4 class="text-uppercase">First choose a deployment to activate your time
                                    </h4>
                                </div>
                                <div class="row" id="chooseCauseRow">
                                    <div class="col-lg-12">
                                        <div id="divCauseDropdown" class="dropdown m-b-md">
				                            <button id="btn-causeDropdown" class="btn dropdown-toggle dropdown-chooseCause" type="button" data-toggle="dropdown">Choose A Deployment <i class="fa fa-globe"></i></button>
				                            <ul id="causeTypeList" class="dropdown-menu">
                                                <asp:Literal ID="litCause" runat="server"></asp:Literal>
				                            </ul>
                                            <asp:HiddenField id="hidCauseId" runat="server" />
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" runat="server" id="btnChooseCause" onclick="chooseCause();">Choose Deployment</button>
                                    <button type="button" class="btn btn-default" data-dismiss="modal">Close Window</button>
                                </div>
                            </div>
                        </div>

                        <div id="divTimesheet" hidden="hidden">
                            <div class="color-line"></div>
                            <div class="modal-header text-center">
                                <h4 class="modal-title"><asp:Literal ID="litCountyHeader" runat="server"></asp:Literal> Volunteer Timesheet</h4>
                                <small class="thin-font">Enter a description of what you are working on and press Activate My Time.</small>
                            </div>
                            <div class="modal-body" style="position:relative;">
                                <div class="bg-success text-center m-b-sm" id="timeEntryAlert" hidden="hidden" style="position:absolute;">
                                    <i class='fa fa-clock-o fa-4x'></i><br />
                                    <h4 class="text-uppercase">Your time has been activated.
                                    </h4>
                                    Remember to sign out when done volunteering.
                                    <p>
                                        <strong>
                                            <asp:Literal ID="Literal2" runat="server" Text="Describe what you worked on and accomplished."></asp:Literal>
                                        </strong>
                                    </p>
                                    <asp:TextBox TextMode="MultiLine" Rows="4" Columns="40" ID="txtWorkCompleteDescription" runat="server"></asp:TextBox>
                                    <br />
                                    <button type="button" class="btn btn-warning" runat="server" id="btnSignOut" onclick="updateTime(false);">Sign Out</button>
                                </div>
                                <div class="row" id="timeEntry">
                                    <div class="col-lg-6">
                                        <p>
                                            <strong>
                                                <asp:Literal ID="litInstructions" runat="server" Text="What volunteer role are you filling?"></asp:Literal>
                                            </strong>
                                        </p>
                                        <div id="divTaskTypedropdown" class="dropdown m-b-md">
				                            <button id="btn-dropdown" class="btn dropdown-toggle dropdown-taskType" type="button" data-toggle="dropdown">Choose A Volunteer Role <i class="pe-7s-id"></i></button>
				                            <ul id="workEventType" class="dropdown-menu">
                                                <asp:Literal ID="litVolunteerType" runat="server"></asp:Literal>
				                            </ul>
                                            <asp:HiddenField id="hidTaskTypeId" runat="server" />
                                        </div>
                                        <div id="divCauseDropdownB" class="dropdown m-b-md">
				                            <button id="btn-causeDropdownB" class="btn dropdown-toggle dropdown-chooseCauseB" type="button" data-toggle="dropdown">Choose A Deployment <i class="fa fa-globe"></i></button>
				                            <ul id="causeTypeListB" class="dropdown-menu">
                                                <asp:Literal ID="litCauseB" runat="server"></asp:Literal>
				                            </ul>
                                            <asp:HiddenField id="hidCauseBId" runat="server" />
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <p>
                                            <strong>
                                                <asp:Literal ID="litWorkDescription" runat="server" Text="Describe what you will be working on."></asp:Literal>
                                            </strong>
                                        </p>
                                        <asp:TextBox TextMode="MultiLine" Rows="6" Columns="30" ID="txtWorkDescription" runat="server"></asp:TextBox>
                                    </div>
                                </div>
                                <div class="bg-info p-xs m-b-sm" id="causeCountyMessage">
                                    <small class="">Your volunteer time will be attributed to the county and deployment listed below.</small>
                                    <h6 class="text-uppercase"><asp:Literal ID="lblCountyState" runat="server"></asp:Literal></h6>
                                    <h6 class="text-uppercase"><asp:Label ID="lblCause" runat="server"></asp:Label></h6>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary" runat="server" id="btnSubmitTime" onclick="updateTime(true);">Activate My Time</button>
                                <button type="button" class="btn btn-default" data-dismiss="modal">Close Window</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="myModalActiveDisasters" tabindex="-1" role="dialog"  aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="color-line"></div>
                        <div class="modal-header text-center">
                            <h4 class="modal-title">My Assistant</h4>
                            <small class="font-bold">Select a Community Portal from your <a href="/V1/Profile/EditDisasters.aspx">profile settings</a>.</small>
                        </div>
                        <div class="modal-body">
                            <p>
                                <asp:HyperLink id="hypActionPage" runat="server" CssClass="btn btn-ls btn-success" Text="Team Activity Page"></asp:HyperLink>
								<hr />
                                <strong><asp:Literal ID="litNonProfitName" runat="server" Visible="false" Text="My Team:"></asp:Literal></strong>
                                <asp:HyperLink id="hypNonProfit" runat="server"></asp:HyperLink>
                                 <br />
                                <asp:HyperLink id="hypInviteTeamMembers" runat="server" CssClass="btn btn-xs btn-success" Text="Invite New Members"></asp:HyperLink>
                                <div class="m-t-md">
                                    <strong>
                                        <span class="nav-label">My Deployments:</span>
                                    </strong>
                                    <ul>
                                        <asp:Literal id="litMyCauses" runat="server"></asp:Literal>
                                    </ul>
                                </div>
                                <div class="m-t-md">
                                    <strong>
                                        <span class="nav-label">My Community Portals:</span>
                                    </strong>
                                    <ul>
                                        <asp:Literal id="litDefaultDisaster" runat="server"></asp:Literal>
                                        <asp:Literal id="litMyDisasters" runat="server"></asp:Literal>
                                    </ul>
                                </div>
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
			<div class="modal fade hmodal-success" id="divUserActionModal" tabindex="-1" role="dialog"  aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="color-line"></div>
                        <div class="modal-header">
                            <h4 class="modal-title">Finish Your Profile</h4>
                            <small class="font-bold">Complete your member profile to start helping today.</small>
                        </div>
                        <div class="modal-body">
                            <p>
								<strong>Follow These Steps (Takes About 2 Minutes)</strong>
								By completing this informtion you're contributing to the overall knowledge of the community in ways that can help everyone collaborate even more effectively.
								<ul class="fa-ul" id="userActionList">
									<li data-url="/V1/Profile/AvailableDates.aspx?userActionModal=false" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=calendarUpdated%>;"></i> <u>Update My Available Deployment Dates</u></li>
									<li data-url="/V1/Profile/EditNonProfits.aspx?userActionModal=false" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=teamUpdated%>;"></i> <u>Choose or Create Your Team</u></li>
									<li data-url="/V1/Profile/EditSkills.aspx?userActionModal=false" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=skillsUpdated%>;"></i> <u>Update Your Skills</u></li>
									<li data-url="/V1/Profile/EditResources.aspx?userActionModal=false" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=resourcesUpdated%>;"></i> <u>Update Your Resources</u></li>
									<li runat="server" id="liDeployment" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=deploymentUpdated%>;"></i> <u>Find or Create a Deployment</u></li>
									<li data-url="/V1/Profile/EditDisasters.aspx?userActionModal=false" class="liUserAction"> <i class="fa-li fa fa-check-square" style="color:<%=communityUpdated%>;"></i> <u>Choose Your Community Portal</u></li>
								</ul>
								Citizens in communities are no longer victims of natrual disasters waiting for help. We are the help because citizens have many of the skills their own community needs
								to successfully recover from natural disasters.
                            </p>
                        </div>
                        <div class="modal-footer">
							<div class="pull-left">
								<ul class="ul_legend text-muted small">
									<li><i class="fa fa-check-square" style="color:yellowgreen;"></i> COMPLETE</li>
									<li><i class="fa fa-check-square" style="color:grey;"></i> UNCOMPLETE</li>
								</ul>
							</div>
                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
		</form>
		
