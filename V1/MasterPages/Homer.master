        <style>
			.skin-option {
					position: fixed;
					text-align: center;
					right: -1px;
					padding: 10px;
					font-size:12px;
					top: 5px;
					text-transform: uppercase;	
					background-color: #ffffff;
					box-shadow: 0 1px 3px 0px rgba(0, 0, 0, 0.05), 10px 5px 7px 3px rgba(0, 0, 0, .1);
					border-radius: 4px 0 0 4px;
					z-index: 100000;
				}
			.pe-7s-mail, .pe-7s-config, .pe-7s-keypad
			{
				color:white;
			}
			.pe-7s-mail:hover, .pe-7s-config:hover, .pe-7s-keypad:hover
			{
				color:black;
			}
			.text-danger{color:#FF0000;}
			.text-warning{color:#ffb606;}
			.text-success{color:#63CB31;}
			.text-website{color:#5E2E91;}

			.divMasterCover {
				width: 100%;
				height: 100vh; /* Full viewport height */
				background-image: url('<%=_masterCoverImage%>'); /* Path to your image */
				background-size: cover; /* Scale the image to cover the entire div */
				background-position: center; /* Center the image */
				background-repeat: no-repeat; /* Prevent the image from repeating */
				height:300px;
				margin-left:-1px;
				margin-top:0px;
				margin-bottom:-200px;
				background-color:#ccc;
			}

			.mobileFooter {
			  position: fixed;
			  bottom: -20px;
			  width: 100%;
			  background-color: #f1f1f1;
			  padding: 10px;
			  padding-bottom:50px;
			  text-align: center;
			  /* Additional styling for the footer */
			}

			@media only screen and (min-width: 768px) {
			  .mobileFooter {
				display: none;
			  }
			}

			.text-light-grey
			{
				color:gray !important;
			}
			.form-control
			{
				background-color:white !important;
				height:34px !important;
			}
			.navbar-form-custom
			{
				margin-top:10px !important; 
			}
			.search-input
			{
			    padding-left: 20px !important; /* Add padding to the left */
				padding-top: 0px !important;  /* Add padding to the top */
				width:280px !important;
			}
			.search-input::placeholder
			{
				color: #ccc !important; /* Customize placeholder text color */
				opacity: 1 !important;  /* Make sure the placeholder is fully opaque */
			}
			.mobile-menu-toggle
			{
				padding:9px 0px !important;
				margin:8px 8px 8px 0px !important;
			}
           .desktop-logo {
                display: inline-block;
            }
           .mobile-logo {
                display: none;
            }
           @media (max-width: 767px) {
                  .desktop-logo {
                 display: none;
              }
	    	.mobile-logo {
            display: inline-block;
            }
           }

		   .header-link.dropdown .dropdown-menu {
				background-color: #fff;
				color: #333;
				min-width: 180px;
			}

			.header-link.dropdown .dropdown-menu li a {
				padding: 10px 15px;
				display: block;
				color: #333;
			}

			.header-link.dropdown .dropdown-menu li a:hover {
				background-color: #f5f5f5;
			}

.narrow-mobile-dropdown {
    width: 90vw;
    max-width: 325px; /* typical max mobile viewport width */
    min-width: 275px;
	margin-left: -120px;
    left: 0 !important;
    padding: 10px;
    box-sizing: border-box;
    border-radius: 6px;
}

.narrow-mobile-dropdown .scrollable-menu {
    max-height: 200px;
    overflow-y: auto;
}

.narrow-mobile-dropdown li a {
    display: block;
    text-align: left;
    padding: 10px;
    color: #333;
    white-space: normal;
}

.narrow-mobile-dropdown li a:hover {
    background-color: #f5f5f5;
}
@media (max-width: 768px) {
    .narrow-mobile-dropdown {
		width: 90vw;
		max-width: 325px; /* typical max mobile viewport width */
		min-width: 275px;
    }
}
