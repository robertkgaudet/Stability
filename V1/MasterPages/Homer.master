	<%=bodyTag%>
    <body class="sidebar-scroll hide-sidebar fixed-navbar <%=fixedFooter%> <%=fixedHeader%> bodyBGColor">		
		<asp:Panel ID="adminFeatureSection" runat="server" Visible="false">
			<div>
				<h5>Site Admin Panel</h5>
