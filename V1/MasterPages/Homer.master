				<!-- Main Wrapper -->
				<div id="wrapper">
						<div id="divMasterCover" class="divMasterCover" runat="server"></div>
						<asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
		
						</asp:ContentPlaceHolder>
					<!-- Footer-->
<%--					<footer class="footer" id="footer" runat="server">
						<span class="pull-right">
							Copyright Stability 2024
						</span>	
					</footer>--%>
					<div class="mobileFooter">
						<div class="row">
							<div class="col-xs-3">
								<a class="fa fa-home pe-2x text-light-grey homeLink" href="/feed"></a>
							</div>
							<div class="col-xs-3">
								<a class="fa fa-users pe-2x text-light-grey teamLink" href="/V1/NonProfit/Default.aspx?organizationId=79305f85-3816-46a8-911f-0d7e3e227c32"></a>
							</div>
							
							<div class="col-xs-3">
								<a class="fa fa-map-o pe-2x text-light-grey portalLink" href="/Disaster/TropicalStormDebby"></a> 
							</div>
							<div class="col-xs-3">
								<a class="fa fa-id-badge pe-2x text-light-grey profileLink" href="/V1/Profile/Profile.aspx"></a> 
							</div>
						</div>
					</div>
