     margin-top: 35px;
}

.suggestion-item {
    border: 1px solid #ccc;
    padding: 8px 12px;
    background-color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .suggestion-item:hover {
    background-color: #f5f5f5;
  }

			#featureTypeCounter{
				    margin-right: 17px;
