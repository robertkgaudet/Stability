								</a>
							</li>
							<li runat="server" id="liMyDisasters" visible="false">
								<a href="#">	 
									<span class="nav-label">Disasters</span><span class="fa arrow"></span> 
								</a>
                                <ul class="nav nav-second-level">
                                   <asp:Literal id="litDefaultDisaster" runat="server"></asp:Literal>
                                   <asp:Literal id="litMyDisasters" runat="server"></asp:Literal>
                                </ul>
							</li>
							<li id="divLocationAdministration" class="bg-info" runat="server" visible="false">
								<a href="#">	 
									<span class="nav-label">Location Admin</span><span class="fa arrow"></span> 
								</a>
