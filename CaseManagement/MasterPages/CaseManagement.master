<%@ Master Language="C#" AutoEventWireup="true" CodeFile="CaseManagement.master.cs" Inherits="CaseManagement_MasterPage" %>

<!DOCTYPE html>
<html>
	<head runat="server">
		<!-- Global site tag (gtag.js) - Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=UA-96039646-1"></script>
		<script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'UA-96039646-1');
        </script>
		<link rel="shortcut icon" href="/favicon.ico">

		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">

		<title runat="server"					id="title">Stability - Day One Disaster Case Management</title>
		<meta name="description"				id="description">
		<meta property="og:image:type"			id="fbImageType" runat="server" />
		<meta property="og:image"				id="fbImage" runat="server"/>
		<meta property="og:title"				id="fbTitle" runat="server"/>
		<meta property="og:url"					id="fbURL" runat="server"/>
		<meta property="og:site_name"			id="fbSite_name" />
		<meta property="og:description"			id="fbDescription" />
		
		<!-- Vendor styles -->
		<link rel="stylesheet" href="/Homer/vendor/fontawesome/css/font-awesome.css" />
		<link rel="stylesheet" href="/Homer/vendor/metisMenu/dist/metisMenu.css" />
		<link rel="stylesheet" href="/Homer/vendor/animate.css/animate.css" />

		<!-- App styles -->
		<link rel="stylesheet" href="/Homer/fonts/pe-icon-7-stroke/css/pe-icon-7-stroke.css" />
		<link rel="stylesheet" href="/Homer/fonts/pe-icon-7-stroke/css/helper.css" />
		<link rel="stylesheet" href="/Homer/styles/style.css">
		<link rel="stylesheet" href="/Homer/vendor/bootstrap/dist/css/bootstrap.css" />
		<link rel="stylesheet" href="/Homer/vendor/bootstrap-toggle-master/css/bootstrap2-toggle.css" />
		<!-- Vendor scripts -->
		<script src="https://code.jquery.com/jquery-3.3.1.js" integrity="sha256-2Kok7MbOyxpgUVvAk/HJ2jigOSYS2auK4Pfzbm7uH60=" crossorigin="anonymous"></script>

		<script type="text/javascript">

            $(document).ready(function () {
                $('#<%=Image1.ClientID%>').click(function () {
                    window.location.href = '/Default.aspx';
                    return false;
                });

                $('#<%=imgProfile.ClientID%>').click(function () {
					window.location.href = <%=profileURL%>;
					return false;
				});
			});

			function updateTime(isUserActive) {
				$.ajax(
					{
						type: "GET",
						url: "/V1/Handlers/UpdateTimesheet.ashx?userId=<%=userId%>&isUserActive=" + isUserActive,
                        data: "",
                        contentType: "text/plain; charset=utf-8",
                        dataType: "html",
                        success: function (data) {
                            if (data != "") {
                                $('#console-event').html(data);
                            }
                        },
                        error: function (request, status, error) {
                            request.statusText + ' - ' + error + ' - ' + status;
                        }
                    });
            }
        </script>

		<style>
			.bodyBGColor
			{
				background-color:#F1F3F6;
			}
			#header
			{	
				background-color:#29498C;
				height:50px;
			}
			#logo:hover	{cursor:pointer; }
			.header-link
			{
				background:none;
				border:none;
				margin-top:-10px;
			}
			.header-link:hover
			{
				background:none;
				border:none;
			}
			#<%=imgProfile.ClientID%>:hover
			{
				cursor:pointer;
			}
			.fa-bars:hover
			{
				color:white;
			}
			#<%=imgProfile.ClientID%> {width:70%;}

			.toggle.ios, .toggle-on.ios, .toggle-off.ios { border-radius: 10px; width:200px; }
			.toggle.ios .toggle-handle { border-radius: 10px; }
			#<%=Image1.ClientID%>
			{
				margin: 10px 0px 0px 10px;
			}
			#<%=Image1.ClientID%>:hover
			{
				cursor:pointer;
			}
			#menu
			{
			 top:32px;
			}
			.content{
			padding:10px;
			}
			.normalheader
			{
			padding:0px 20px 20px 20px;
			}
		</style>
        <style>
			.skin-option {
					position: fixed;
					text-align: center;
					right: -1px;
					padding: 6px 20px 4px 8px;
					font-size:10px;
					top: 5px;
					text-transform: uppercase;	
					background-color: #ffffff;
					box-shadow: 0 1px 3px 0px rgba(0, 0, 0, 0.05), 10px 5px 7px 3px rgba(0, 0, 0, .1);
					border-radius: 4px 0 0 4px;
					z-index: 100000;
				}
		</style>
		<asp:ContentPlaceHolder id="head" runat="server">
		</asp:ContentPlaceHolder>
	</head>
	<body class="sidebar-scroll fixed-navbar <%=fixedFooter%> <%=fixedHeader%> bodyBGColor">
		<form id="form1" runat="server" role="form">
            <div class="skin-option animated fadeInRight">
