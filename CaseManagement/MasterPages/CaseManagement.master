									<span class="">
										<asp:Literal ID="litUsername" runat="server"></asp:Literal>
									</span>
									<div class="dropdown m-b-sm" id="divSettings" runat="server" visible="false">
										<a class="dropdown-toggle" href="#" data-toggle="dropdown">
											<small class="text-muted">Settings<b class="caret"></b></small>
										</a>
										<ul class="dropdown-menu animated flipInX m-t-xs">
											<li><asp:HyperLink ID="hypProfile" runat="server" Text="My Profile" NavigateUrl="~/V1/Profile/Profile.aspx"></asp:HyperLink></li>
											<li runat="server" id="liPrintIdCard"><asp:HyperLink ID="hypPrintIDCard" runat="server" Text="Print ID Card" NavigateUrl="~/IDCard"></asp:HyperLink></li>
											<li><asp:HyperLink ID="hypTime" runat="server" Text="Record Time" NavigateUrl="~/CaseManagement/Time.aspx"></asp:HyperLink></li>
											<li><asp:HyperLink ID="hypSignOut" runat="server" Text="Sign Out" NavigateUrl="~/CaseManagement/SignOut.aspx"></asp:HyperLink></li>
										</ul>
									</div>
									<div class="m-b-sm">
										<input type="checkbox" id="activeStatus" runat="server" data-toggle="toggle" data-style="ios" data-on="<i class='fa fa-clock-o'></i> Active" data-off="<i class='fa fa-user-circle-o'></i> Inactive" data-size="normal" data-onstyle="info">
										<div id="console-event"></div>
									</div>
									<div class="dropdown" id="divLogin" runat="server" visible="false">
										<asp:HyperLink ID="hypLogin" runat="server" Text="Sign In" NavigateUrl="~/V1/Login.aspx"></asp:HyperLink>
									</div>
								</div>
							</div>
							<li>
								<a href="/CaseManagement/<%=urlFriendlyName%>">
