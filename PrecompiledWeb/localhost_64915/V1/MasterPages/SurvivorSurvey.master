<%@ master language="C#" autoeventwireup="true" inherits="V1_MasterPages_SurvivorSurvey, App_Web_qwo5cswo" %>

<!DOCTYPE html>
<html>
	<head runat="server">
		<!-- Global site tag (gtag.js) - Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=UA-96039646-1"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());

			gtag('config', 'UA-96039646-1');
		</script>
		<link rel="shortcut icon" href="/favicon.ico">

		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">

		<title runat="server"					id="title">Stability - Disaster relief done differently.</title>
		<meta name="description"				id="description">
		<meta property="og:image:type"			id="fbImageType" runat="server" />
		<meta property="og:image"				id="fbImage" runat="server"/>
		<meta property="og:title"				id="fbTitle" runat="server"/>
		<meta property="og:url"					id="fbURL" runat="server"/>
		<meta property="og:site_name"			id="fbSite_name" />
		<meta property="og:description"			id="fbDescription" />

		<!-- Vendor styles -->
		<link rel="stylesheet" href="/Homer/vendor/fontawesome/css/font-awesome.css" />
		<link rel="stylesheet" href="/Homer/vendor/metisMenu/dist/metisMenu.css" />
		<link rel="stylesheet" href="/Homer/vendor/animate.css/animate.css" />
		<link rel="stylesheet" href="/Homer/vendor/bootstrap/dist/css/bootstrap.css" />

		<!-- App styles -->
		<link rel="stylesheet" href="/Homer/fonts/pe-icon-7-stroke/css/pe-icon-7-stroke.css" />
		<link rel="stylesheet" href="/Homer/fonts/pe-icon-7-stroke/css/helper.css" />
		<link rel="stylesheet" href="/Homer/styles/style.css">

		<!-- Vendor scripts -->
		<script src="https://code.jquery.com/jquery-3.3.1.js" integrity="sha256-2Kok7MbOyxpgUVvAk/HJ2jigOSYS2auK4Pfzbm7uH60=" crossorigin="anonymous"></script>

		<script type="text/javascript">

			$(document).ready(function () {
				$('#logo').click(function () {
					window.location.href = '/Web/Index.html';
					return false;
				});

				$('#<%=imgProfile.ClientID%>').click(function () {
					window.location.href = <%=profileURL%>;;
					return false;
				});
			});
		</script>

		<style>
			.bodyBGColor
			{
				background-color:#F1F3F6;
			}
			#header
			{
				background-color:#34495E;
			}
			#logo:hover	{cursor:pointer; }
			.header-link
			{
				background:none;
				border:none;
			}
			.header-link:hover
			{
				background:none;
				border:none;
			}
			#<%=imgProfile.ClientID%>:hover
			{
				cursor:pointer;
			}
			.fa-bars:hover
			{
				color:white;
			}
			#<%=imgProfile.ClientID%> {width:100%;}
		</style>
        <style>
    .skin-option {
            position: fixed;
            text-align: center;
            right: -1px;
            padding: 10px;
            font-size:10px;
            top: 5px;
            text-transform: uppercase;
            background-color: #ffffff;
            box-shadow: 0 1px 10px 0px rgba(0, 0, 0, 0.05), 10px 12px 7px 3px rgba(0, 0, 0, .1);
            border-radius: 4px 0 0 4px;
            z-index: 100000;
        }
    </style>
		<asp:ContentPlaceHolder id="head" runat="server">
		</asp:ContentPlaceHolder>
	</head>
	<%=bodyTag%>
		<form id="form1" runat="server" role="form">
            <div class="skin-option animated fadeInRight">
               <asp:HyperLink id="hypDefaultDisaster" runat="server"></asp:HyperLink>
            </div>
			<div style="margin-bottom:500px;">
				<div id="header" runat="server">
