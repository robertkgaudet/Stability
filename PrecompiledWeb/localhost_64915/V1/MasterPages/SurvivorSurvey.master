							<div class="collapse mobile-navbar" id="mobile-collapse">
								<ul class="nav navbar-nav">
									<li>
										<a class="" href="/V1/Profile/Default.aspx">My Dashboard</a>
									</li>
									<li runat="server" id="liSurvivorPortal">
										<a class="" href="/Stories">Survivor Help</a>
									</li>
									<li>
