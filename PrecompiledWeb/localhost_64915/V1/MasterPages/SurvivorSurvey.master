								</a>
							</li>
						</ul>
						<div id="divAdminLinks" runat="server" visible="false">
							<div class="profile-picture">
								<div class="stats-label text-color">
									<span class="font-extra-bold font-uppercase">
										Administration
									</span>
								</div>
							</div>
							<ul class="nav m-b" id="side-menu">
