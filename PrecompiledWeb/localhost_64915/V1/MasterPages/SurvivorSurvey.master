											<li><asp:HyperLink ID="hypSignOut" runat="server" Text="Sign Out" NavigateUrl="~/V1/SignOut.aspx"></asp:HyperLink></li>
										</ul>
									</div>
									<span class="font-uppercase">
										<asp:Literal ID="litRoleType" runat="server"></asp:Literal>
